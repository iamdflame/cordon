{
  "name": "cordon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Permission-propagating enterprise knowledge graph. Derived facts inherit the intersection of their sources access control.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "api": "tsx src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "hydra:up": "bash scripts/hydra-up.sh",
    "hydra:down": "docker rm -f hydradb",
    "build:graph": "tsx src/cli.ts",
    "audit": "tsx src/bench/run.ts",
    "demo:leak": "tsx src/bench/demo.ts",
    "audit:github": "tsx src/bench/github.ts",
    "audit:channels": "tsx src/bench/channels.ts",
    "attack": "tsx src/attack/run.ts",
    "capture": "tsx src/bench/capture.ts",
    "audit:contested": "tsx src/bench/contested.ts",
    "audit:contested:github": "tsx src/bench/contested.ts --github",
    "mcp": "tsx src/mcp/server.ts",
    "bench:latency": "tsx src/bench/latency.ts",
    "bench:engine": "tsx src/bench/engine-probe.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "neo4j-driver": "^6.2.0",
    "semver": "^7.6.3",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}